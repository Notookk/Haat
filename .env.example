# ---------------------------------------------------------------------------
# HAAT — environment matrix (referential only, never commit real secrets)
# Copy to .env at the repository root; apps/api loads it via dotenv.
# ---------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Database (MongoDB) — replica set required for transactions (slot checkout)
MONGODB_URI=mongodb://127.0.0.1:27017/haat?replicaSet=rs0
MONGODB_DB_NAME=haat

# Cache / pub-sub (Part 3 — chat adapter). Optional in Part 1.
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change_me_min_32_characters_long_secret
JWT_REFRESH_SECRET=change_me_min_32_characters_long_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=haat_rt
BCRYPT_COST=12

# Payments (Part 3)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_signature_secret

# Media — Cloudinary (signed direct uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_FOLDER=haat/dev
CLOUDINARY_UPLOAD_PRESET=

# Frontend (Vite) — only VITE_* vars reach the browser
VITE_API_URL=http://localhost:5000/api/v1
