# ---------------------------------------------------------------------------
# HAAT — Environment Matrix
# All ports are dynamically configurable here.
# ---------------------------------------------------------------------------

NODE_ENV=development

# ---------------------------------------------------------------------------
# Port Allocations
# ---------------------------------------------------------------------------
# Buyer Frontend: 3000
BUYER_PORT=3000
# Buyer Backend: 4000
BUYER_BACKEND_PORT=4000

# Admin Frontend: 5000
ADMIN_PORT=5000
# Admin Backend: 6000
ADMIN_BACKEND_PORT=6000

# Seller Frontend: 7000
SELLER_PORT=7000
# Seller Backend: 7100
SELLER_BACKEND_PORT=7100

# WebSocket Gateway: 8000
WS_PORT=8000

# ---------------------------------------------------------------------------
# URLs
# ---------------------------------------------------------------------------
BUYER_URL=http://localhost:3000
BUYER_API_URL=http://localhost:4000
SELLER_URL=http://localhost:7000
SELLER_API_URL=http://localhost:7100
ADMIN_URL=http://localhost:5000
ADMIN_API_URL=http://localhost:6000
WS_URL=ws://localhost:8000

# Vite client URLs
VITE_BUYER_API_URL=/api/v1
VITE_SELLER_API_URL=/api/v1
VITE_ADMIN_API_URL=/api/v1

# Backwards compatibility aliases
PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:5000

# ---------------------------------------------------------------------------
# Database (MongoDB 7+) — replica set recommended
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/haat?replicaSet=rs0
MONGODB_DB_NAME=haat

# ---------------------------------------------------------------------------
# Authentication & Sessions
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=change_me_to_at_least_32_characters_long_secret_key_1234
JWT_REFRESH_SECRET=change_me_to_at_least_32_characters_long_secret_key_5678
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=haat_rt
BCRYPT_COST=12

# ---------------------------------------------------------------------------
# Initial Development Admin Bootstrap (Never commit real production secrets)
# ---------------------------------------------------------------------------
ADMIN_BOOTSTRAP_EMAIL=admin@haat.com
ADMIN_BOOTSTRAP_PASSWORD=admin@123456

# ---------------------------------------------------------------------------
# Payments (Razorpay — Part 3)
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_signature_secret

# ---------------------------------------------------------------------------
# Media Storage (Cloudinary)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_FOLDER=Haat
