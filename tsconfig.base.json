{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@haat/shared-contracts": ["shared/contracts/src/index.ts"],
      "@haat/shared-contracts/*": ["shared/contracts/src/*"],
      "@haat/shared-backend": ["shared/backend/src/index.ts"],
      "@haat/shared-backend/*": ["shared/backend/src/*"],
      "@haat/shared-frontend": ["shared/frontend/src/index.ts"],
      "@haat/shared-frontend/*": ["shared/frontend/src/*"]
    }
  }
}
